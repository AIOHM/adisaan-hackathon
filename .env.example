APP_NAME="AdiSaan Observatory"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=observatory
# DB_USERNAME=observatory
# DB_PASSWORD=

SESSION_DRIVER=database
QUEUE_CONNECTION=database
CACHE_STORE=database

OBSERVATORY_URL=https://adisaan.com
OBSERVATORY_NAME=AdiSaan
OBSERVATORY_CONTACT=contact@adisaan.com
OBSERVATORY_MEDIA_BASE=https://adisaan.com

# Meta Model API, Standard mode. Create a key at https://dev.meta.ai
META_API_KEY=
META_MONTHLY_LIMIT_USD=10
OBSERVATORY_REVIEW_MODEL=muse-spark-1.3
OBSERVATORY_SYNTHESIS_MODEL=muse-spark-1.3
